# Copy to config.yaml and edit. Nothing sensitive belongs in this file —
# the API token goes in .env instead (see .env.example).

# masterpiece_bot app registered at developers.deriv.com/dashboard
app_id: 33ULSRYkmDK8Y515CmE1l
symbol: R_100        # Volatility 100 Index — a common Digits-trading symbol
stake: 3.00
currency: USD
backtest_ticks: 5000  # how many historical ticks `backtest` pulls

scan_trade:
  # interval_seconds: 45      # cycle cadence (default 45s, not 30)

  # Seven cheapest symbols. Measured on two independent days:
  #   these seven      2.57-2.81%
  #   R_100, 1HZ100V, 1HZ10V   3.82-3.91%
  # Same split both days, no overlap - structural, not noise. Those three
  # took 68% of all volume traded so far.
  symbols: [R_10, R_25, R_50, R_75, 1HZ25V, 1HZ50V, 1HZ75V]

  # Two cheapest families. Measured WITHIN the seven symbols above, so the
  # symbol effect cannot be confused with the family effect:
  #   over_under 2.29%   even_odd 2.30%   rise_fall 3.79%
  # Two still interchange, so the rotation keeps its variety.
  categories: [over_under, even_odd]
  selection:
    # Stage 1: best contract type within each symbol.
    # Stage 2: best of those 10 winners. (Mathematically the same as one
    # global argmax over all 60 quotes.)
    #
    # Ranked on the QUOTED house edge - a fact from the live quote - not on
    # an observed win rate, which is an estimate. Picking the max of 60
    # estimates every cycle selects the luckiest far more often than the
    # best; the study, which does something milder, measured 10.89% WORSE
    # than abstaining.
    #
    # The old `rotation` paid a mean 2.967% edge across 1,669 trades while
    # 2.25% was quoted in the same cycle - 44.4% of trades went out at
    # 3.75-3.80% purely because it was that category's turn.
    # ROTATION is the default and what runs. It interchanges category and
    # symbol every cycle, so trades spread across all 10 symbols and all
    # three contract families.
    #
    # `global_best` (best leg per symbol, then best overall) pays a lower
    # mean edge on paper, but in practice it concentrates every single trade
    # onto whichever leg is cheapest - measured as R_10 DIGITOVER in 200 of
    # 200 cycles. Available, not default.
    mode: rotation

  study:
    # Study recent digit history before each stake instead of trading purely
    # on rotation + cheapest quoted margin.
    enabled: true
    window: 200               # digits scored on a normal cycle (1 extra API call)
    deep_window: 1000         # after a LOSS, look at this many instead
    deep_after_loss: true     # after a loss, score EVERY symbol, not just the
                              # rotated one (~10 API calls — the deliberate
                              # "look harder after a loss" path)
    min_z: 2.0                # abstain unless the observed vs theoretical gap
                              # clears this many standard errors (~95%). Lower
                              # it and the bot starts chasing noise; that is the
                              # whole failure mode this guards against.
    mode: momentum            # momentum = back what is over-performing,
                              # reversion = back what is "due"
    # Expect frequent abstentions. Deriv's digits have passed every
    # independence test in this repo, and on an independent stream abstaining
    # is the correct answer. Check with `study-report` and `independence-test`.

staking:
  # 8-rung RECOVERY ladder. Each rung recovers the cycle's cumulative loss
  # assuming a 0.9231 net payout (the ~3.8%-margin contracts), then wraps
  # back to 3 after the 8th loss. Full unwon ladder = $509.95.
  #
  # Measured against the old 7-rung doubling ladder from $5, on the real
  # edge mix over 600k trades:
  #     -229 vs -509 per 1,000 trades, wipeout every 511 vs 254 trades,
  #     worst case 509.95 vs 635.00, mean stake 8.00 vs 17.69.
  # Loss as a % of staked is unchanged (~2.87%) - the gain is from staking
  # less, not from a better bet.
  #
  # WHY IT PAIRS WITH selection.mode: global_best. Sized for the WORST
  # contract, so every recovery landing on a cheaper one over-recovers into
  # profit (+0.10 at rung 2 up to +7.96 at rung 8 on a 2.25% contract). At
  # exactly 0.9231 a win on rungs 2-8 returns zero. Cheap selection is what
  # makes the recovery rungs earn anything at all.
  name: recovery_ladder
  assumed_net_multiplier: 0.9231
  reset_after_losses: 8
  sequence: [3, 3.25, 6.77, 14.10, 29.36, 61.13, 127.29, 265.05]
  # `sequence` is explicit on purpose: recomputing it compounds rounding and
  # drifts ~0.2% by the eighth rung, and this is the number the worst case
  # is built on.

  # Previous ladder, kept for comparison:
  # name: doubling
  # multiplier: 2.0
  # max_stake_multiple: 64
  # reset_after_losses: 7

strategy:
  name: low_edge             # digit_frequency | even_odd_frequency | streak_reversal | low_edge
  every: 15                   # bet every N ticks (~2s/tick, so ~1 trade per 30s)
  contract_type: DIGITOVER     # per scan-edge: 2.17% margin, tied for cheapest
  barrier: 0
  # other strategies' params: digit_frequency/even_odd_frequency take
  # window + threshold (+ over_under_barrier for digit_frequency);
  # streak_reversal takes streak_len + over_under_barrier. Unsupported keys
  # for the chosen strategy raise a TypeError — swap the block when you
  # change name.

risk:
  # MUST exceed one full ladder (509.95), or the ladder can never finish:
  # at 300 it took every loss on the climb and then had only 55 left for the
  # 265.05 rung, so it paid for the climb and never got the recovery bet.
  # 1000 leaves room for one full ladder plus most of a second.
  max_daily_loss: 1000.0
  max_consecutive_losses: 20  # high on purpose: consecutive losses are expected with a
                              # ladder; max_daily_loss is what actually protects the session
  max_trades: 100000            # effectively unlimited — max_daily_loss/target_profit are the real stops
  target_profit: 1000.0       # symmetric with the -1000 stop. Symmetric bounds are NOT
                              # an even bet: every contract carries a 2.25-3.80% house
                              # edge, so -1000 is the more likely of the two to arrive.

journal_path: trade_journal.csv

alerts:
  # The supervisor writes events here; tools/alert_watcher.ps1 runs in the
  # logged-in session and toasts them. Two processes because the supervisor
  # runs S4U in session 0, which has no desktop and cannot toast at all.
  enabled: true
  file: alerts.jsonl
  stall_seconds: 300          # no settled trade for this long => stalled, restart it.
                              # Generous on purpose: real gaps reach ~94s, and a
                              # cycle is skipped when a category is not offered.
  cooldown_seconds: 900       # per event type, so one outage is one toast
  crash_loop_restarts: 3      # this many restarts inside the window below =>
  crash_loop_window_seconds: 600   # self-healing is failing, worth interrupting for
  # Ordinary drops that recover in ~5s deliberately produce NO alert. They
  # happen about twice an hour and cost nothing; alerting on them would train
  # you to ignore the channel.

supervisor:
  # 'continue' = after the bot hits target_profit, relaunch immediately and
  # keep trading back to back instead of banking the win and waiting for the
  # next UTC day. Consequence: the +1000 target never actually banks
  # anything, so -1000 (max_daily_loss) becomes the only outcome that ends a
  # day. Set to 'stop' to bank at the target instead.
  on_target: stop

  # null = no day-level profit cap; each SESSION banks at risk.target_profit
  # (RiskManager measures from process start) and then waits for the next UTC
  # day. Set a number here to also cap the whole day's profit.
  # The day-level LOSS backstop (risk.max_daily_loss) always applies.
  day_target_profit: null
