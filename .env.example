# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real token.

# Create a Personal Access Token (PAT) at
# https://developers.deriv.com/dashboard > API tokens (Trade scope needed).
# It looks like: pat_<64 hex chars>. One PAT can access both your demo and
# real accounts — DEMO_MODE below controls which one the bot trades on.
DERIV_API_TOKEN=your-pat-token-here

# Leave this as true until you've validated the bot end-to-end in demo.
# true  -> the bot only ever connects to your DEMO account.
# false -> the bot connects to your REAL account (and asks for a typed
#          confirmation phrase before starting; see main.py).
DEMO_MODE=true

# ---------------------------------------------------------------------------
# SECOND ACCOUNT (.env.ac2)
#
# The S/R bot runs two demo accounts side by side as an A/B test on trade
# direction - see CLAUDE.md. Account 2 needs its own file, `.env.ac2`, with the
# same two keys but that account's own PAT:
#
#     DERIV_API_TOKEN=pat_<account 2's token>
#     DEMO_MODE=true
#
# It is passed with `--env-file .env.ac2` (see tools/install_sr_task.ps1).
# NEVER share one PAT across two people or commit either file - both are
# gitignored via `.env.*`.
#
# You will also need `config.yaml` (copy config.example.yaml). run_sr_bot.py
# reads `app_id` from it and crashes without it.
