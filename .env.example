# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real token.

# Get a token at https://app.deriv.com/account/api-token — start with a
# token generated on a DEMO account, not your real one.
DERIV_API_TOKEN=your-demo-api-token-here

# Leave this as true until you've validated the bot end-to-end in demo.
# The bot refuses to trade a real-money token while this is true, and
# refuses to run at all if you flip it to false while still holding a
# demo token's response (see main.py).
DEMO_MODE=true
